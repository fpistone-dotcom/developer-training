    <assignments>
        <name>Set_Watermark_Shown</name>
        <label>Set Watermark Shown</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>$Record.SBQQ__WatermarkShown__c</assignToReference>
