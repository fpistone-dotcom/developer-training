            </value>
        </assignmentItems>
    </assignments>
    <description>IC-08: always checks Watermark Shown on the Quote. CPQ only prints the template watermark when this field is true, and only the &quot;SmartBytes Quote - DRAFT&quot; template has a watermark image, so DRAFT documents show &quot;DRAFT&quot; and FINAL documents do not.</description>
    <interviewLabel>Quote Set Watermark Shown {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Set Watermark Shown</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Set_Watermark_Shown</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>SBQQ__WatermarkShown__c</field>
            <operator>EqualTo</operator>
