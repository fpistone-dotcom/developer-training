/**
 * @description Tests for DEV #3 (Part 2): RenewalQuoteBatch.
 *              They check OUR part: which Contracts fall in the 30-day window, that the CPQ
 *              flags are checked and that the Renewal Opportunity moves from Prospecting to
 *              'Proposal/Price Quote'. The Renewal Quote is generated by CPQ (package code) and
 *              that is tested in the org.
 *
 *              Dates: Salesforce calculates a Contract's EndDate (start + term - 1 day).
 *              createActivatedContracts receives the EndDate we want and calculates the start.
 *
 *              In the tests the Batch runs with size 200 (and not with BATCH_SIZE = 1): in a
 *              test, execute() runs only once, so with size 1 it would process only one Contract.
 */
@IsTest
private class RenewalQuoteBatchTest {

    private static final Integer BULK_SIZE = 200;
    private static final Integer CONTRACT_TERM = 12;

    /**
     * @description Common data for all the tests: an Account.
     */
    @testSetup
    static void setup() {
        TestDataFactory.createAccount();
    }

    /**
     * @description Positive: an activated Contract that ends in 19 days ends up with Renewal Quoted
     *              and Renewal Forecast checked.
     */
    @isTest
    static void contractInWindowQuotedTest() {
        Contract con = createActivatedContracts( Date.today().addDays( 19 ), 1 )[0];

        Test.startTest();
        Database.executeBatch( new RenewalQuoteBatch(), BULK_SIZE );
        Test.stopTest();

        Contract result = getContract( con.Id );
        System.assertEquals( true, result.SBQQ__RenewalQuoted__c,
            'A Contract ending within 30 days should have Renewal Quoted checked' );
        System.assertEquals( true, result.SBQQ__RenewalForecast__c,
            'Renewal Forecast should stay checked' );
    }

    /**
     * @description Edge case: ends today and ends in exactly 30 days -> they are in. Ends in 31 days and
     *              ended yesterday -> they are out.
     */
    @isTest
    static void windowBoundaryTest() {
        Contract endsToday = createActivatedContracts( Date.today(), 1 )[0];
        Contract endsIn30Days = createActivatedContracts( Date.today().addDays( 30 ), 1 )[0];
        Contract endsIn31Days = createActivatedContracts( Date.today().addDays( 31 ), 1 )[0];
        Contract endedYesterday = createActivatedContracts( Date.today().addDays( -1 ), 1 )[0];

        Test.startTest();
        Database.executeBatch( new RenewalQuoteBatch(), BULK_SIZE );
        Test.stopTest();

        System.assertEquals( true, getContract( endsToday.Id ).SBQQ__RenewalQuoted__c,
            'A Contract ending today is still inside the window' );
        System.assertEquals( true, getContract( endsIn30Days.Id ).SBQQ__RenewalQuoted__c,
            'A Contract ending in exactly 30 days is inside the window' );
        System.assertEquals( false, getContract( endsIn31Days.Id ).SBQQ__RenewalQuoted__c,
            'A Contract ending in 31 days is not in the window yet' );
        System.assertEquals( false, getContract( endedYesterday.Id ).SBQQ__RenewalQuoted__c,
            'An expired Contract should not be processed' );
    }

    /**
     * @description Negative: a Draft Contract that ends in 19 days is not processed.
     */
    @isTest
    static void draftContractNotQuotedTest() {
        Contract con = TestDataFactory.createContract( getAccountId(), getStartDateFor( Date.today().addDays( 19 ) ), CONTRACT_TERM );

        Test.startTest();
        Database.executeBatch( new RenewalQuoteBatch(), BULK_SIZE );
        Test.stopTest();

        System.assertEquals( false, getContract( con.Id ).SBQQ__RenewalQuoted__c,
            'A Contract that is not activated should not be processed' );
    }

    /**
     * @description Negative: an evergreen Contract (no end date) is not processed.
     */
    @isTest
    static void evergreenContractNotQuotedTest() {
        Contract con = TestDataFactory.createContract( getAccountId(), Date.today().addMonths( -11 ), null );
        con.Status = ContractTriggerHandler.STATUS_ACTIVATED;
        update con;

        Test.startTest();
        Database.executeBatch( new RenewalQuoteBatch(), BULK_SIZE );
        Test.stopTest();

        System.assertEquals( false, getContract( con.Id ).SBQQ__RenewalQuoted__c,
            'An evergreen Contract has no end, so it should not be processed' );
    }

    /**
     * @description Safety net: an activated Contract without Renewal Forecast (for example,
     *              activated before the deploy) ends up with both flags checked.
     */
    @isTest
    static void missingForecastSafetyNetTest() {
        Contract con = createActivatedContracts( Date.today().addDays( 19 ), 1 )[0];
        con.SBQQ__RenewalForecast__c = false;
        update con;

        Test.startTest();
        Database.executeBatch( new RenewalQuoteBatch(), BULK_SIZE );
        Test.stopTest();

        Contract result = getContract( con.Id );
        System.assertEquals( true, result.SBQQ__RenewalForecast__c,
            'The Batch should check Renewal Forecast if it was missing' );
        System.assertEquals( true, result.SBQQ__RenewalQuoted__c,
            'The Batch should check Renewal Quoted' );
    }

    /**
     * @description Positive + negative: the Renewal Opportunity in Prospecting moves to
     *              'Proposal/Price Quote'; the one a sales rep already moved forward is not touched.
     */
    @isTest
    static void opportunityStageUpdatedTest() {
        List<Contract> contractList = createActivatedContracts( Date.today().addDays( 19 ), 2 );
        Opportunity prospectingOpp = TestDataFactory.buildRenewalOpportunities( getAccountId(),
            new List<Contract>{ contractList[0] }, RenewalQuoteBatch.STAGE_PROSPECTING )[0];
        Opportunity advancedOpp = TestDataFactory.buildRenewalOpportunities( getAccountId(),
            new List<Contract>{ contractList[1] }, 'Negotiation/Review' )[0];
        insert new List<Opportunity>{ prospectingOpp, advancedOpp };

        Test.startTest();
        Database.executeBatch( new RenewalQuoteBatch(), BULK_SIZE );
        Test.stopTest();

        System.assertEquals( RenewalQuoteBatch.STAGE_PROPOSAL, getOpportunity( prospectingOpp.Id ).StageName,
            'The Renewal Opportunity in Prospecting should move to Proposal/Price Quote' );
        System.assertEquals( 'Negotiation/Review', getOpportunity( advancedOpp.Id ).StageName,
            'A Renewal Opportunity that already moved forward should not go back' );
        System.assertEquals( 0, [SELECT COUNT() FROM Error_Log__c], 'There should be no errors' );
    }

    /**
     * @description Negative (idempotency): a Contract that already has a Renewal Quote is not processed
     *              again, so its Opportunity is not touched.
     */
    @isTest
    static void alreadyQuotedNotReprocessedTest() {
        Contract con = createActivatedContracts( Date.today().addDays( 19 ), 1 )[0];
        con.SBQQ__RenewalQuoted__c = true;
        update con;
        Opportunity opp = TestDataFactory.buildRenewalOpportunities( getAccountId(),
            new List<Contract>{ con }, RenewalQuoteBatch.STAGE_PROSPECTING )[0];
        insert opp;

        Test.startTest();
        Database.executeBatch( new RenewalQuoteBatch(), BULK_SIZE );
        Test.stopTest();

        System.assertEquals( RenewalQuoteBatch.STAGE_PROSPECTING, getOpportunity( opp.Id ).StageName,
            'A Contract that already had a Renewal Quote should not be processed again' );
    }

    /**
     * @description Bulk: 200 Contracts in the window, each one with its Renewal Opportunity.
     *
     *              SBQQ.TriggerControl.disable() (CPQ package API, outside the course): turns off the
     *              CPQ triggers ONLY in this test. Without it, when activating 200 Contracts (and checking
     *              200 Renewal Quoted) CPQ breaks the query limit inside ITS code
     *              ("SBQQ: Too many SOQL queries: 101"). This test checks OUR bulkification
     *              (1 query and 2 updates per chunk). For the same reason the real job uses chunks of 1.
     */
    @isTest
    static void bulkTest() {
        SBQQ.TriggerControl.disable();
        List<Contract> contractList = createActivatedContracts( Date.today().addDays( 19 ), BULK_SIZE );
        insert TestDataFactory.buildRenewalOpportunities( getAccountId(), contractList, RenewalQuoteBatch.STAGE_PROSPECTING );

        Test.startTest();
        Database.executeBatch( new RenewalQuoteBatch(), BULK_SIZE );
        Test.stopTest();

        Integer quotedCount = [SELECT COUNT() FROM Contract WHERE SBQQ__RenewalQuoted__c = true];
        System.assertEquals( BULK_SIZE, quotedCount, 'The 200 Contracts should have Renewal Quoted checked' );
        Integer proposalCount = [
            SELECT COUNT()
            FROM Opportunity
            WHERE SBQQ__Renewal__c = true
            AND StageName = :RenewalQuoteBatch.STAGE_PROPOSAL
        ];
        System.assertEquals( BULK_SIZE, proposalCount, 'The 200 Renewal Opportunities should move to Proposal/Price Quote' );
    }

    // ---------------------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------------------

    /**
     * @description Creates 12-month Contracts that end on the given date and activates them
     *              (insert in Draft + Status update, because they cannot be inserted activated).
     * @param endDate           EndDate we want
     * @param numberOfContracts Number of Contracts
     * @return Activated Contracts
     */
    private static List<Contract> createActivatedContracts( Date endDate, Integer numberOfContracts ) {
        List<Contract> contractList = TestDataFactory.buildContracts( getAccountId(), getStartDateFor( endDate ),
            CONTRACT_TERM, numberOfContracts );
        insert contractList;
        for ( Contract con : contractList ) {
            con.Status = ContractTriggerHandler.STATUS_ACTIVATED;
        }
        update contractList;
        return contractList;
    }

    /**
     * @description EndDate = start + 12 months - 1 day, so start = (EndDate + 1 day) - 12 months.
     * @param endDate EndDate we want
     * @return Start date for a 12-month Contract
     */
    private static Date getStartDateFor( Date endDate ) {
        return endDate.addDays( 1 ).addMonths( -CONTRACT_TERM );
    }

    private static Id getAccountId() {
        return [SELECT Id FROM Account LIMIT 1].Id;
    }

    private static Contract getContract( Id contractId ) {
        return [SELECT Id, EndDate, SBQQ__RenewalForecast__c, SBQQ__RenewalQuoted__c FROM Contract WHERE Id = :contractId];
    }

    private static Opportunity getOpportunity( Id opportunityId ) {
        return [SELECT Id, StageName FROM Opportunity WHERE Id = :opportunityId];
    }
}
