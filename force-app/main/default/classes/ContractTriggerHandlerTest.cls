/**
 * @description Tests for DEV #3 (Part 1): ContractTrigger and ContractTriggerHandler.
 *              They check OUR part: that SBQQ__RenewalForecast__c is checked when the Status
 *              changes to Activated. The Renewal Opportunity is generated by CPQ (package code),
 *              and that is tested in the org, not in a unit test.
 */
@IsTest
private class ContractTriggerHandlerTest {

    private static final Integer BULK_SIZE = 200;

    /**
     * @description Common data for all the tests: an Account.
     */
    @testSetup
    static void setup() {
        TestDataFactory.createAccount();
    }

    /**
     * @description Positive: a Draft Contract that is activated ends up with Renewal Forecast checked.
     */
    @isTest
    static void activationSetsRenewalForecastTest() {
        Contract con = TestDataFactory.createContract( getAccountId(), Date.today(), 12 );

        Test.startTest();
        con.Status = ContractTriggerHandler.STATUS_ACTIVATED;
        update con;
        Test.stopTest();

        System.assertEquals( true, getContract( con.Id ).SBQQ__RenewalForecast__c,
            'When activated, the Contract should have Renewal Forecast checked' );
    }

    /**
     * @description Bulk: 200 Contracts activated together all end up with Renewal Forecast checked.
     *
     *              SBQQ.TriggerControl.disable() (CPQ package API, outside the course): turns off the
     *              CPQ triggers ONLY in this test. Without it, SBQQ.ContractAfter tries to generate
     *              200 Renewal Opportunities and breaks the query limit INSIDE CPQ's code
     *              ("SBQQ: Too many SOQL queries: 101"); our trigger uses 0 queries. This test
     *              checks that OUR code handles 200 records. What CPQ generates was tested in the
     *              org, and the non-bulk tests run with CPQ turned on.
     */
    @isTest
    static void activationBulkTest() {
        List<Contract> contractList = TestDataFactory.buildContracts( getAccountId(), Date.today(), 12, BULK_SIZE );
        insert contractList;
        SBQQ.TriggerControl.disable();

        Test.startTest();
        for ( Contract con : contractList ) {
            con.Status = ContractTriggerHandler.STATUS_ACTIVATED;
        }
        update contractList;
        Test.stopTest();

        Integer forecastCount = [
            SELECT COUNT()
            FROM Contract
            WHERE SBQQ__RenewalForecast__c = true
        ];
        System.assertEquals( BULK_SIZE, forecastCount, 'The 200 activated Contracts should have Renewal Forecast checked' );
    }

    /**
     * @description Negative: if the Status changes to another value (In Approval Process), it is not checked.
     */
    @isTest
    static void otherStatusDoesNotSetForecastTest() {
        Contract con = TestDataFactory.createContract( getAccountId(), Date.today(), 12 );

        Test.startTest();
        con.Status = 'In Approval Process';
        update con;
        Test.stopTest();

        System.assertEquals( false, getContract( con.Id ).SBQQ__RenewalForecast__c,
            'If the Contract is not activated, Renewal Forecast should not be checked' );
    }

    /**
     * @description Negative: if another field is edited and the Status does not change, it is not checked.
     */
    @isTest
    static void otherFieldUpdateDoesNotSetForecastTest() {
        Contract con = TestDataFactory.createContract( getAccountId(), Date.today(), 12 );

        Test.startTest();
        con.Description = 'Edited';
        update con;
        Test.stopTest();

        System.assertEquals( false, getContract( con.Id ).SBQQ__RenewalForecast__c,
            'Editing another field should not check Renewal Forecast' );
    }

    /**
     * @description Negative: an already activated Contract where someone unchecks Renewal Forecast
     *              and then edits it is not checked again (the Status did not change).
     */
    @isTest
    static void alreadyActivatedNotReprocessedTest() {
        Contract con = TestDataFactory.createContract( getAccountId(), Date.today(), 12 );
        con.Status = ContractTriggerHandler.STATUS_ACTIVATED;
        update con;
        con.SBQQ__RenewalForecast__c = false;
        update con;

        Test.startTest();
        con.Description = 'Edited after activation';
        update con;
        Test.stopTest();

        System.assertEquals( false, getContract( con.Id ).SBQQ__RenewalForecast__c,
            'If the Status did not change in this transaction, the trigger should not check the flag again' );
    }

    // ---------------------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------------------

    private static Id getAccountId() {
        return [SELECT Id FROM Account LIMIT 1].Id;
    }

    private static Contract getContract( Id contractId ) {
        return [SELECT Id, Status, SBQQ__RenewalForecast__c FROM Contract WHERE Id = :contractId];
    }
}
